# Copy to .env and fill in. .env is gitignored — never commit a key.

# ── the safety catch ────────────────────────────────────────────────────────
# false  → everything runs, nothing is sent. Start here. Always.
# true   → it spends real money the moment a pool fills.
ARMED=false

# ── RPC ─────────────────────────────────────────────────────────────────────
# The public endpoints work but are shared and rate-limited. On launch day the
# difference between a paid endpoint and a public one is the difference between
# hearing the block and hearing about it. Alchemy or QuickNode, Base mainnet.
BASE_HTTP=https://mainnet.base.org
BASE_WSS=wss://mainnet.base.org

# ── telegram: the front door ────────────────────────────────────────────────
# This is how people join. They send /start, the bot GENERATES a wallet for
# them and shows the address, they fund it themselves, then /spend 0.02.
# Nobody ever pastes a private key into a chat.
#
# Make the bot with @BotFather, add it to your group, then get the chat id from
#   https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Encrypts every generated key at rest in .wallets.json. Any long random string.
# Lose this and the wallets are unrecoverable — so is the money in them.
WALLET_SECRET=

# ── wallets by hand (optional) ──────────────────────────────────────────────
# Only used when nobody has joined via Telegram. Fresh wallets holding just what
# they will spend plus gas. Never a key that has anything else in it.
#SNIPER_1_NAME=francis
#SNIPER_1_PK=0x
#SNIPER_1_SPEND=0.02

# ── gas ─────────────────────────────────────────────────────────────────────
# Overpaying is the point. A launch block is contested and being outbid by a
# gwei costs the entire trade.
PRIORITY_FEE_GWEI=0.05
MAX_FEE_MULTIPLIER=3
